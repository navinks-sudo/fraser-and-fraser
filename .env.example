# Copy to `.env` and fill in your own values.

# --- Primary OCR (Ollama, local) -------------------------------------------
# Ollama exposes an OpenAI-compatible endpoint at /v1.
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen2.5vl:7b

# --- Gemini (fallback OCR + structured extraction + tree synthesis) --------
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# --- App ------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_URL=sqlite+aiosqlite:///./genealogiq.db
STORAGE_BASE=./storage
ALLOWED_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://localhost:3001", "http://127.0.0.1:3001", "http://127.0.0.1:3000"]
