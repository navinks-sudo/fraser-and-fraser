# Copy to `.env` and fill in your own values.
# Every AI knob is env-driven so the deployment can re-target the pipeline
# without code changes.

# ── OpenAI-compatible AI endpoint ───────────────────────────────────────
# Works against any OpenAI-compatible host:
#   OpenAI: https://api.openai.com/v1            (key = sk-…)
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai/  (key = AIza…)
#   Ollama: http://localhost:11434/v1            (key = ollama)
#   vLLM / llama.cpp / Groq / Together — same shape
OPENAI_API_KEY=YOUR_KEY_HERE
OPENAI_BASE_URL=https://api.openai.com/v1

# One model for everything; per-stage overrides below are optional
OPENAI_DEFAULT_MODEL=gpt-4o-mini

OPENAI_VISION_MODEL=
OPENAI_EXTRACTION_MODEL=
OPENAI_TREE_MODEL=
OPENAI_TRANSLATION_MODEL=

OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=4096
OPENAI_TIMEOUT=600
OPENAI_MAX_RETRIES=3

# ── App ─────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
# Access-token lifetime in minutes. 1440 = 24h.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DATABASE_URL=sqlite+aiosqlite:///./genealogiq.db
STORAGE_BASE=./storage
ALLOWED_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://localhost:3001", "http://127.0.0.1:3001", "http://127.0.0.1:3000"]
